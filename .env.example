# Copy to .env and fill in. Never commit the real .env file.

# --- BiZZdesign Horizzon connection -----------------------------------------
# Base URL of your Horizzon tenant, e.g. https://<your-org>.horizzon.cloud
ARCHFLOW_HORIZZON_BASE_URL=
# OAuth2 client credentials issued by your BiZZdesign administrator
ARCHFLOW_HORIZZON_CLIENT_ID=
ARCHFLOW_HORIZZON_CLIENT_SECRET=
# Optional: explicit token endpoint if it differs from <base_url>/oauth/token
ARCHFLOW_HORIZZON_TOKEN_URL=

# --- Application -------------------------------------------------------------
# SQLite by default; any SQLAlchemy URL works
ARCHFLOW_DATABASE_URL=sqlite:///archflow.db
# Where generated artifacts (documents, ArchiMate exports) are written
ARCHFLOW_ARTIFACTS_DIR=artifacts
